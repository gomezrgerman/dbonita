# ── Sitio ────────────────────────────────────────────────
# Mientras no sea "true", toda la web pública redirige a /proximamente
SITE_ENABLED=false
# true = reserva online (calendario + senal con Stripe). Vacio/false = solicitud por WhatsApp, pago en el centro
NEXT_PUBLIC_RESERVAS_ONLINE=false
# Token para ver la web real estando en Próximamente: https://www.dbonita.es/?preview=TOKEN
PREVIEW_TOKEN=
# URL pública (se usa en los enlaces de los emails)
NEXT_PUBLIC_SITE_URL=https://www.dbonita.es

# ── Contacto ─────────────────────────────────────────────
# WhatsApp (prefijo internacional sin + ni espacios)
NEXT_PUBLIC_WHATSAPP_NUMBER=34657332722
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/dbonitadenia/
NEXT_PUBLIC_BUSINESS_EMAIL=dbonitadenia@gmail.com

# ── Supabase — SOLO servidor ─────────────────────────────
# Project Settings → API. La service role key NUNCA debe llevar NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ───────────────────────────────────────────────
# dashboard.stripe.com → Developers → API keys (pk_live / sk_live en producción)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Developers → Webhooks → endpoint https://www.dbonita.es/api/webhook/stripe (con www: Stripe no sigue redirecciones)
# con el evento payment_intent.succeeded → "Signing secret"
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Emails (Resend) — SOLO servidor ──────────────────────
# Clave de resend.com (API Keys). Sin ella los emails se omiten.
RESEND_API_KEY=
# Email del centro que recibe el aviso de cada reserva nueva
EMAIL_NEGOCIO=dbonitadenia@gmail.com
# Opcionales
EMAIL_FROM=D Bonita <reservas@dbonita.es>
EMAIL_REPLY_TO=dbonitadenia@gmail.com

# ── Panel de administración — SOLO servidor ──────────────
PANEL_PASSWORD=cambiar-antes-de-produccion
# Cadena aleatoria larga (p. ej. `openssl rand -hex 32`)
PANEL_HMAC_SECRET=
